PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lostlink_items?retryWrites=true&w=majority
# Base URL of the deployed Claim Service (no trailing slash)
CLAIM_SERVICE_URL=http://localhost:5002
# Shared secret used for service-to-service calls (must match Claim Service)
SERVICE_KEY=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins ("*" allows all)
CORS_ORIGIN=*
