PORT=5002
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lostlink_claims?retryWrites=true&w=majority
# Base URL of the deployed Item Service (no trailing slash)
ITEM_SERVICE_URL=http://localhost:5001
# Shared secret used for service-to-service calls (must match Item Service)
SERVICE_KEY=change-me-to-a-long-random-string
# Comma-separated list of allowed frontend origins ("*" allows all)
CORS_ORIGIN=*
