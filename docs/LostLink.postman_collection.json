    {
      "key": "claimUrl",
      "value": "http://localhost:5002"
    },
    {
      "key": "serviceKey",
      "value": "change-me-to-a-long-random-string"
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "lostItemId",
      "value": ""
    },
    {
      "key": "claimId",
      "value": ""
    },
    {
      "key": "claimId2",
      "value": ""
    }
  ],
