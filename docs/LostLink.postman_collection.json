        {
          "name": "Item Service health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Service is item-service', () => pm.expect(pm.response.json().service).to.eql('item-service'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{itemUrl}}/health",
              "host": [
                "{{itemUrl}}"
