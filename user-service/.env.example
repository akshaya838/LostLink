PORT=5003
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lostlink_users?retryWrites=true&w=majority
# Secret used to sign login tokens - must be the SAME on all three services
JWT_SECRET=change-me-to-another-long-random-string
# Shared secret for service-to-service calls (same on all three services)
SERVICE_KEY=change-me-to-a-long-random-string
# The admin desk account is created automatically on first start
ADMIN_NAME=Lost and Found Desk
ADMIN_EMAIL=admin@college.edu
ADMIN_PASSWORD=change-this-admin-password
CORS_ORIGIN=*
